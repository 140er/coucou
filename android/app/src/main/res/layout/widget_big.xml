<?xml version="1.0" encoding="utf-8"?>
<!-- The Mochi Big widget: a large Mochi with a glow, a speech bubble that says who is doing what in plain words (never a command or a file), and the agent's name and state. Plain RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/big_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <FrameLayout
        android:id="@+id/big_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/big_bubble"
            android:text="@string/widget_initial_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_bubble"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/widget_bubble_text"
            android:textSize="@dimen/widget_text_name"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_bubble_tail" />

        <ImageView
            android:id="@+id/big_mochi"
            android:src="@drawable/preview_mochi_idle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_big_label"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/big_row"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/big_dot"
                android:tint="@color/widget_tone_muted"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />

            <TextView
                android:id="@+id/big_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_text_name"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/big_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="@dimen/widget_text_state" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/big_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/big_buttons_a"
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_tile_height"
                android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/big_tile_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_bg"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_btn_home"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/big_tile_chat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_bg"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_chat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_btn_chat"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/big_tile_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_bg"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_btn_settings"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/big_tile_recent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_bg"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_recent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_btn_recent"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_secondary" />
            </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/big_buttons_b"
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_tile_height"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:visibility="gone">

            <LinearLayout
                android:id="@+id/big_tile_session"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_bg"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_session" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_btn_session"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/big_tile_pair"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_bg"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_pair" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_btn_pair"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_secondary" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/big_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/widget_badge_bg"
        android:gravity="center"
        android:minWidth="22dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="#FF1C1C1E"
        android:textSize="@dimen/widget_text_secondary"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
