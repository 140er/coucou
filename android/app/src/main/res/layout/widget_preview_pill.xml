<?xml version="1.0" encoding="utf-8"?>
<!-- Preview of Status Pill: a blue dot, Claude Code, Working.
     A still picture for the Widget picker (android:previewLayout): sample text and numbers, no ids, nothing from the app, no runtime bitmap.
     It uses the same card, border, gradient, type scale and state colours as the real Widget, so the picker shows what you will get. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_working" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

            <ImageView
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="@color/widget_tone_working" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_sample_claude"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_text_name"
                android:textStyle="bold"
                android:layout_marginStart="10dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_sample_working"
                android:textColor="@color/widget_text_secondary"
                android:textSize="@dimen/widget_text_state"
                android:layout_marginStart="10dp" />
    </LinearLayout>
</FrameLayout>
